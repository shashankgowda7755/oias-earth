{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "app/client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "app/server/dist/**,app/db/migrations/**,app/client/dist/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
