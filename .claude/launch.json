{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "email-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "."],
      "cwd": ".",
      "port": 5200,
      "autoPort": true
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5199"],
      "cwd": "app/client",
      "port": 5199,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "app/server",
      "port": 4000,
      "autoPort": false
    }
  ]
}
