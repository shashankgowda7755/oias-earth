# Optional: point the auth login call at a separate auth host. Defaults to the
# proxied /api/v1 when unset (Express server handles /api/v1/auth/login).
# VITE_AUTH_BASE_URL=/api/v1

# Dev-only: override the backend origin the Vite proxy targets. Read by
# vite.config.ts (process.env, not import.meta), so set it when running `vite`.
# SERVER_ORIGIN=http://localhost:4000
