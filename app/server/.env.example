# CommuniTREE admin server — local dev env. Copy to .env and adjust.
# (.env is gitignored; this .example file is the committed template.)

# Postgres connection string (node-postgres / pg Pool).
# LEAVE UNSET to run with NO Postgres install — the server then uses embedded
# PGlite (@electric-sql/pglite), persisted to ./.pglite-data. Set this only when
# you want to point at a real Postgres instead.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/communitree

# JWT signing secret. CHANGE for anything beyond local dev.
JWT_SECRET=dev-only-change-me-communitree-secret

# JWT lifetime (jsonwebtoken expiresIn syntax).
JWT_EXPIRES_IN=7d

# HTTP port for the Express server.
PORT=4000

# Comma-separated list of allowed CORS origins (the Vite client dev server).
CORS_ORIGIN=http://localhost:5173
